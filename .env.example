# =============================================================================
# Copy to `.env` and/or `.env.local`. Never commit real secrets.
# =============================================================================
#
# Prisma CLI reads `.env` only. This repo’s `npm run db:*` scripts load `.env`
# then `.env.local` (override). For raw `npx prisma`, put variables in `.env`.
#
# -----------------------------------------------------------------------------
# PostgreSQL (Neon recommended)
# -----------------------------------------------------------------------------
#
# In Neon: Project → Connect → copy two connection strings:
#   • Pooled (hostname contains "-pooler") → DATABASE_URL
#   • Direct (same user/db, hostname without "-pooler") → DIRECT_URL
#
# Always use SSL, e.g. ?sslmode=require
# If you only have one URL, paste it into BOTH variables for local dev.
#
# If `npx prisma migrate` fails with P1001, your network may block outbound
# port 5432—try another network or run migrations from CI / Vercel.
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth (required)
# -----------------------------------------------------------------------------
#
# Generate:  openssl rand -base64 32
#
AUTH_SECRET=""

# Base URL of the app (used for Auth.js callbacks and absolute URLs).
# Local:
AUTH_URL="http://localhost:3000"
#
# Production (Vercel): set to your canonical site URL, e.g.
#   https://your-app.vercel.app
# Or your custom domain:
#   https://tasks.example.com
#
# Vercel often provides VERCEL_URL (without scheme). You can set AUTH_URL in
# the Vercel dashboard to `https://$VERCEL_URL` for preview deploys, or use
# your production domain only on the Production environment.
